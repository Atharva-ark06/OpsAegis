OPS_AEGIS_ENV=development
OPS_AEGIS_SECRET_KEY=development-only-change-this
OPS_AEGIS_ACCESS_TOKEN_MINUTES=15
DATABASE_URL=postgresql+psycopg://opsaegis:change-me@postgres:5432/opsaegis
REDIS_URL=redis://redis:6379/0
CORS_ORIGINS=http://localhost:5173
POSTGRES_DB=opsaegis
POSTGRES_USER=opsaegis
POSTGRES_PASSWORD=change-me

# Optional Wazuh Indexer connection (backend only).
WAZUH_INDEXER_URL=
WAZUH_INDEXER_USERNAME=
WAZUH_INDEXER_PASSWORD=
WAZUH_INDEXER_INDEX_PATTERN=wazuh-alerts-*
WAZUH_INDEXER_CA_CERT=
WAZUH_INDEXER_TIMEOUT_SECONDS=10
WAZUH_INDEXER_MAX_RESULTS=500

# Optional CrowdSec Local API connection; use a read-only bouncer API key.
CROWDSEC_LAPI_URL=
CROWDSEC_API_KEY=
CROWDSEC_CA_CERT=
CROWDSEC_TIMEOUT_SECONDS=10
CROWDSEC_MAX_RESULTS=500

NUCLEI_ENABLED=false
NUCLEI_BINARY=nuclei
NUCLEI_TIMEOUT_SECONDS=600
NUCLEI_MAX_OUTPUT_BYTES=10485760
NUCLEI_RATE_LIMIT=5
