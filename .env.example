# LOCAL DEVELOPMENT ONLY — these defaults are intentionally unsafe and must never be used in production.
# Production startup enforces strong secrets, PostgreSQL, non-loopback Redis and explicit HTTPS CORS origins.
OPS_AEGIS_ENV=development
OPS_AEGIS_SECRET_KEY=development-only-change-this
OPS_AEGIS_ACCESS_TOKEN_MINUTES=15
AUTH_LOGIN_IP_LIMIT=30
AUTH_LOGIN_EMAIL_LIMIT=5
AUTH_LOGIN_IP_WINDOW_SECONDS=60
AUTH_LOGIN_EMAIL_WINDOW_SECONDS=900
DATABASE_URL=postgresql+psycopg://opsaegis:change-me@postgres:5432/opsaegis
REDIS_URL=redis://redis:6379/0
CORS_ORIGINS=http://localhost:5173
POSTGRES_DB=opsaegis
POSTGRES_USER=opsaegis
POSTGRES_PASSWORD=change-me

# Wazuh Manager API (read-only agent inventory; HTTPS and CA verification required)
WAZUH_MANAGER_URL=
WAZUH_MANAGER_USERNAME=
WAZUH_MANAGER_PASSWORD=
WAZUH_MANAGER_CA_CERT=
WAZUH_MANAGER_TIMEOUT_SECONDS=10
WAZUH_MANAGER_MAX_AGENTS=500

WAZUH_INDEXER_URL=
WAZUH_INDEXER_USERNAME=
WAZUH_INDEXER_PASSWORD=
WAZUH_INDEXER_INDEX_PATTERN=wazuh-alerts-*
WAZUH_INDEXER_CA_CERT=
WAZUH_INDEXER_TIMEOUT_SECONDS=10
WAZUH_INDEXER_MAX_RESULTS=500

CROWDSEC_LAPI_URL=
CROWDSEC_API_KEY=
# Optional: enables bounded alert-history reads; use a dedicated CrowdSec machine account.
# Machine credentials can authenticate to broader LAPI operations; OpsAegis uses them only for login + GET /alerts.
CROWDSEC_MACHINE_ID=
CROWDSEC_MACHINE_PASSWORD=
CROWDSEC_CA_CERT=
CROWDSEC_TIMEOUT_SECONDS=10
CROWDSEC_MAX_RESULTS=500

# Optional threat-intelligence provider credentials; keep these server-side only.
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
THREAT_INTEL_TIMEOUT_SECONDS=10
THREAT_INTEL_CACHE_TTL_SECONDS=900

# Optional NVD API key; backend only. Request at https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=
NVD_TIMEOUT_SECONDS=10

NUCLEI_ENABLED=false
NUCLEI_BINARY=nuclei
NUCLEI_TIMEOUT_SECONDS=600
NUCLEI_MAX_OUTPUT_BYTES=10485760
NUCLEI_RATE_LIMIT=5

# Shannon is disabled until a separately isolated bridge is deployed.
SHANNON_ENABLED=false
SHANNON_RUNNER_URL=
SHANNON_RUNNER_TOKEN=
SHANNON_TIMEOUT_SECONDS=15
SHANNON_MAX_RESPONSE_BYTES=5242880
SHANNON_MAX_FINDINGS=200
