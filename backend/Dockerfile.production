FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONPATH=/app

WORKDIR /app

COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt \
    && groupadd --gid 10001 opsaegis \
    && useradd --uid 10001 --gid opsaegis --create-home --shell /usr/sbin/nologin opsaegis

COPY --chown=opsaegis:opsaegis app ./app
COPY --chown=opsaegis:opsaegis migrations ./migrations
COPY --chown=opsaegis:opsaegis scripts ./scripts
COPY --chown=opsaegis:opsaegis alembic.ini ./
RUN mkdir -p /var/lib/opsaegis/evidence && chown -R opsaegis:opsaegis /var/lib/opsaegis

USER 10001:10001
EXPOSE 8000

# Do not trust arbitrary X-Forwarded-* headers; configure a trusted proxy explicitly if required.
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--no-proxy-headers"]
