# Copy to .env.production and replace every placeholder before deployment.
# Use: docker compose --env-file .env.production -f compose.production.yaml up -d --build
OPS_AEGIS_ENV=production
OPS_AEGIS_SECRET_KEY=REPLACE_WITH_OUTPUT_FROM_PYTHON_SECRETS_TOKEN_URLSAFE_48
OPS_AEGIS_ACCESS_TOKEN_MINUTES=15

POSTGRES_DB=opsaegis
POSTGRES_USER=opsaegis
POSTGRES_PASSWORD=REPLACE_WITH_UNIQUE_DATABASE_PASSWORD_AT_LEAST_16_CHARS
DATABASE_URL=postgresql+psycopg://opsaegis:REPLACE_WITH_URL_SAFE_DATABASE_PASSWORD@postgres:5432/opsaegis

REDIS_PASSWORD=REPLACE_WITH_UNIQUE_REDIS_PASSWORD
REDIS_URL=redis://:REPLACE_WITH_URL_SAFE_REDIS_PASSWORD@redis:6379/0

# Public browser origin(s), comma-separated. Must be HTTPS.
CORS_ORIGINS=https://soc.example.com

# Keep scanner execution disabled in production until isolated execution is deployed.
NUCLEI_ENABLED=false
SHANNON_ENABLED=false
