# Copy to .env.production and replace every CHANGE_ME value before deployment.
# Use: docker compose --env-file .env.production -f compose.production.yaml up -d --build
OPS_AEGIS_ENV=production
OPS_AEGIS_SECRET_KEY=CHANGE_ME_GENERATE_WITH_PYTHON_SECRETS
OPS_AEGIS_ACCESS_TOKEN_MINUTES=15

POSTGRES_DB=opsaegis
POSTGRES_USER=opsaegis
POSTGRES_PASSWORD=CHANGE_ME_USE_UNIQUE_URL_SAFE_PASSWORD
DATABASE_URL=postgresql+psycopg://opsaegis:CHANGE_ME@postgres:5432/opsaegis

REDIS_PASSWORD=CHANGE_ME_USE_UNIQUE_URL_SAFE_PASSWORD
REDIS_URL=redis://:CHANGE_ME@redis:6379/0

# Public browser origin(s), comma-separated. Must be HTTPS.
CORS_ORIGINS=https://soc.example.com

# Keep scanner execution disabled in production until isolated execution is deployed.
NUCLEI_ENABLED=false
SHANNON_ENABLED=false
